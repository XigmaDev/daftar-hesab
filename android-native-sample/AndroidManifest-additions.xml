<!--
  افزودنی‌های لازم به android/app/src/main/AndroidManifest.xml
  (این فایل جایگزین AndroidManifest.xml نیست؛ فقط بخش‌هایی که باید داخل آن اضافه شوند.)
-->

<!-- داخل تگ <manifest> و قبل از <application> اضافه شود: -->
<uses-permission android:name="android.permission.RECEIVE_SMS" />
<uses-permission android:name="android.permission.READ_SMS" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

<!--
  گیرنده‌ی ایستا (Manifest-declared) — این تنها راه قابل‌اعتماد برای دریافت پیامک
  در پس‌زمینه، حتی وقتی برنامه به‌طور کامل بسته/Kill شده، است. این تگ را داخل
  تگ <application> اضافه کنید. کلاس آن باید دقیقاً با SmsBroadcastReceiver.kt
  مطابقت داشته باشد (که باید در همان پکیج قرار گرفته باشد).
-->
<receiver
    android:name="ir.local.daftartarakonesh.SmsBroadcastReceiver"
    android:exported="true"
    android:permission="android.permission.BROADCAST_SMS">
    <intent-filter android:priority="999">
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
    </intent-filter>
</receiver>

<!--
  بررسی کنید (خیلی مهم):
  ۱) فایل SmsBroadcastReceiver.kt واقعاً در مسیر
     android/app/src/main/java/ir/local/daftartarakonesh/SmsBroadcastReceiver.kt قرار دارد.
  ۲) applicationId در android/app/build.gradle دقیقاً برابر است با
     "ir.local.daftartarakonesh" (یا هرچه در capacitor.config.json برای appId
